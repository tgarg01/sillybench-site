---
import Base from '../layouts/Base.astro';
import { RUNS, REPRO_TABLE } from '../data/runs';
import { SITE } from '../site.config';
import { repoUrl } from '../lib/url';
---

<Base title="Runs" description="The measurement runs behind every post: setup, versions, headline results, and a full reproduction on a fresh machine.">
  <header class="wrap-narrow head">
    <p class="kicker">Lab notebook</p>
    <h1>The runs behind the numbers</h1>
    <p class="lede">
      Every number on this site comes from one of these runs. Each run folder in{' '}
      <a href={SITE.labsRepo}>Sillybench</a> keeps its <code>config.json</code>, the environment capture (driver, clocks,
      every package version), the raw benchmark and profiler output, the analysis notebook’s tables and figures, and a
      sha256 manifest of every file.
    </p>
  </header>

  <div class="wrap-narrow">
    {
      RUNS.map((r) => (
        <section class="run card" id={r.id} aria-labelledby={`h-${r.id}`}>
          <p class="kicker">
            {r.kind} · {r.date}
          </p>
          <h2 id={`h-${r.id}`} class="mono rid">
            {r.id}
          </h2>
          <p>{r.summary}</p>
          <dl>
            {r.setup.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
          <h3>Headline results</h3>
          <ul>
            {r.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
          <p class="links">
            <a class="btn ghost" href={repoUrl(SITE.labsRepo, 'main', `runs/${r.id}`)}>Run folder on GitHub</a>
            <a href={repoUrl(SITE.labsRepo, 'main', `runs/${r.id}/analysis`)}>analysis/</a>
          </p>
        </section>
      ))
    }

    <section class="repro" aria-labelledby="repro-h">
      <h2 id="repro-h">Does it reproduce?</h2>
      <p>
        Decode latency per step from <code>vllm bench latency</code> (512-token prompt), original run vs the fresh-VM
        reproduction:
      </p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Batch</th><th>Original ms/step</th><th>Reproduced ms/step</th><th>Diff</th><th>Tokens/s</th></tr>
          </thead>
          <tbody>
            {
              REPRO_TABLE.map((row) => (
                <tr>
                  <td class="mono">{row.batch}</td>
                  <td class="mono">{row.original.toFixed(2)}</td>
                  <td class="mono">{row.repro.toFixed(2)}</td>
                  <td class="mono">{row.diff}</td>
                  <td class="mono">{row.tps}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="muted small">Source: Sillybench README, “Reproduced from scratch”.</p>
    </section>
  </div>
</Base>

<style>
  .head {
    padding-top: 3rem;
    padding-bottom: 1.5rem;
  }
  .lede {
    color: var(--ink-2);
    margin-top: 1rem;
  }
  .run {
    padding: 1.4rem 1.25rem;
    margin-bottom: 1.5rem;
    scroll-margin-top: 5rem;
  }
  .run:target {
    border-color: var(--green);
  }
  .rid {
    font-family: var(--font-mono);
    font-size: clamp(0.95rem, 0.8rem + 0.8vw, 1.15rem);
    font-weight: 600;
    overflow-wrap: anywhere;
    margin: 0.2rem 0 0.75rem;
  }
  dl {
    display: grid;
    gap: 0.3rem;
    margin: 0 0 1rem;
  }
  dl div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 0.75rem;
    font-size: 0.93rem;
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
  }
  h3 {
    font-size: 1.15rem;
    margin: 1rem 0 0.4rem;
  }
  ul {
    padding-left: 1.2rem;
    margin: 0 0 1rem;
    font-size: 0.95rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin: 0;
  }
  .repro {
    margin-top: 2.5rem;
  }
  .repro h2 {
    margin-bottom: 0.6rem;
  }
  .table-scroll {
    overflow-x: auto;
  }
  td {
    font-size: 0.92rem;
  }
  .small {
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }
  @media (max-width: 480px) {
    dl div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
