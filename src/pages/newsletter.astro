---
import Base from '../layouts/Base.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
---

<Base title="Newsletter" description="One email when a new episode is out, plus one figure that doesn't fit on LinkedIn.">
  <div class="wrap-narrow page">
    <h1>Newsletter</h1>
    <p class="lede">
      LinkedIn gets the short version of each episode. The email gets the link to the full version, plus one extra figure
      from the run that didn’t fit.
    </p>
    <NewsletterForm />
  </div>
</Base>

<style>
  .page {
    padding-top: 3rem;
  }
  .lede {
    font-size: 1.1rem;
    color: var(--ink-2);
    margin-top: 1rem;
  }
</style>
