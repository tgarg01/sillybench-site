---
// Home: one headline, one link into the series, and the latest episode's animation. Nothing else.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url, mediaUrl, postUrl } from '../lib/url';
import { SERIES } from '../data/series';

const all = await getCollection('posts', (p) => !p.data.draft);
const latest = [...all].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || b.data.episode - a.data.episode)[0];
const series = [...SERIES].sort((a, b) => b.number - a.number).find((s) => all.some((p) => p.data.series === s.id));
---

<Base>
  <section class="wrap hero">
    <div class="intro">
      <h1 class="headline">
        Understand LLM inference by <span class="hl">visualizing</span> it on real hardware with real numbers.
      </h1>
      {
        series && (
          <a class="btn series-link" href={url(`/series/${series.id}/`)}>
            Series {series.number}: {series.title} <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
    {
      latest && (
        <a class="hero-media card" href={postUrl(latest.id)} aria-label={`Watch episode ${latest.data.episode}: ${latest.data.title}`}>
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={mediaUrl(latest.data.media.dir, latest.data.media.loop.poster)}
            width={latest.data.media.loop.width}
            height={latest.data.media.loop.height}
            data-home-loop
          >
            <source src={mediaUrl(latest.data.media.dir, latest.data.media.loop.mp4)} type="video/mp4" />
          </video>
        </a>
      )
    }
  </section>
</Base>

<script>
  const v = document.querySelector<HTMLVideoElement>('[data-home-loop]');
  if (v && matchMedia('(prefers-reduced-motion: reduce)').matches) {
    v.removeAttribute('autoplay');
    v.pause();
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3.5rem;
    align-items: center;
    min-height: calc(100vh - 60px - 10rem);
    padding-top: 3rem;
    padding-bottom: 1rem;
  }
  .headline {
    font-size: clamp(2.1rem, 1.4rem + 2.8vw, 3.4rem);
    line-height: 1.15;
  }
  .hl {
    color: var(--green);
    background: linear-gradient(transparent 62%, var(--green-soft) 62%);
  }
  .series-link {
    margin-top: 2rem;
    font-size: 1rem;
    padding: 0.85rem 1.2rem;
    line-height: 1.3;
  }
  .hero-media {
    display: block;
    overflow: hidden;
    transform: rotate(1deg);
  }
  .hero-media video {
    width: 100%;
    aspect-ratio: 1;
    background: #f7f3ec;
  }
  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2.25rem;
      min-height: 0;
      padding-top: 2.5rem;
    }
    .hero-media {
      max-width: 30rem;
      transform: none;
    }
  }
</style>
