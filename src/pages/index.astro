---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { SITE } from '../site.config';
import { url, mediaUrl, postUrl } from '../lib/url';
import { SERIES, PLAN, TOTAL_PARTS } from '../data/series';

const posts = (await getCollection('posts', (p) => !p.data.draft)).sort((a, b) => b.data.part - a.data.part);
const latest = posts[0];
const published = new Set(posts.map((p) => p.data.part));
const next = PLAN.find((p) => !published.has(p.part));
---

<Base>
  <section class="wrap hero">
    <div class="intro">
      <p class="kicker">{SITE.name}</p>
      <h1>LLM inference, <span class="hl">measured</span> on real GPUs.</h1>
      <p class="lede">
        I take one model, one inference engine and one H100, and explain what the GPU is actually doing, one idea per
        post. Every number is my own measurement, every claim names its source file, and every post links a notebook that
        reproduces it.
      </p>
      <div class="cta">
        <a class="btn" href={url(`/series/${SERIES.id}/`)}>Start the series</a>
        {latest && <a class="btn ghost" href={postUrl(latest.id)}>Latest: Part {latest.data.part}</a>}
      </div>
    </div>
    {
      latest && (
        <a class="hero-media card" href={postUrl(latest.id)} aria-label={`Watch part ${latest.data.part}: ${latest.data.title}`}>
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={mediaUrl(latest.data.media.dir, latest.data.media.loop.poster)}
            width={latest.data.media.loop.width}
            height={latest.data.media.loop.height}
            data-home-loop
          >
            <source src={mediaUrl(latest.data.media.dir, latest.data.media.loop.mp4)} type="video/mp4" />
          </video>
        </a>
      )
    }
  </section>

  <section class="wrap pillars" aria-label="How this works">
    <div class="pillar">
      <span class="n hand">1</span>
      <h2 class="h3">Measured</h2>
      <p>Qwen3.8-27B on vLLM, profiled on an H100 with Nsight Systems and Nsight Compute. No borrowed benchmarks.</p>
    </div>
    <div class="pillar">
      <span class="n hand">2</span>
      <h2 class="h3">Sourced</h2>
      <p>Each post ends with where every number comes from: the run, the file, the formula, the datasheet.</p>
    </div>
    <div class="pillar">
      <span class="n hand">3</span>
      <h2 class="h3">Reproducible</h2>
      <p>
        The <a href={SITE.labsRepo}>Sillybench</a> notebooks print each post’s numbers on any laptop, or re-measure them on
        your GPU. A full re-run on a fresh machine landed within 0.6%.
      </p>
    </div>
  </section>

  <section class="wrap series">
    <div class="series-head">
      <div>
        <p class="kicker">Season 1 · {posts.length} of {TOTAL_PARTS} parts out</p>
        <h2>{SERIES.title}</h2>
      </div>
      <a href={url(`/series/${SERIES.id}/`)}>Full roadmap →</a>
    </div>
    <div class="grid">
      {posts.map((p) => <PostCard post={p} />)}
      {
        next && (
          <div class="soon card">
            <p class="kicker">Coming next · Part {next.part}</p>
            <p class="hand t">{next.title}</p>
            <p class="muted">{next.concept}</p>
          </div>
        )
      }
    </div>
  </section>

  <div class="wrap-narrow">
    <NewsletterForm />
  </div>
</Base>

<script>
  const v = document.querySelector<HTMLVideoElement>('[data-home-loop]');
  if (v && matchMedia('(prefers-reduced-motion: reduce)').matches) {
    v.removeAttribute('autoplay');
    v.pause();
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3rem;
    align-items: center;
    padding-top: 4rem;
    padding-bottom: 3rem;
  }
  .hl {
    color: var(--green);
    background: linear-gradient(transparent 62%, var(--green-soft) 62%);
  }
  .lede {
    font-size: 1.15rem;
    color: var(--ink-2);
    margin: 1.25rem 0 1.75rem;
    max-width: 36rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .hero-media {
    display: block;
    overflow: hidden;
    transform: rotate(1deg);
  }
  .hero-media video {
    width: 100%;
    aspect-ratio: 1;
    background: #f7f3ec;
  }
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }
  .pillar {
    border-top: 2px solid var(--ink);
    padding-top: 1rem;
  }
  .pillar .n {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--green);
  }
  .h3 {
    font-size: 1.4rem;
    margin: 0.1rem 0 0.4rem;
  }
  .pillar p {
    color: var(--ink-2);
    font-size: 0.98rem;
    margin: 0;
  }
  .series {
    padding-top: 3rem;
  }
  .series-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }
  .series-head .kicker {
    margin: 0 0 0.35rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1.25rem;
  }
  .soon {
    padding: 1.25rem;
    border-style: dashed;
    background: transparent;
    box-shadow: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .soon .t {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0.4rem 0;
  }
  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-top: 2.5rem;
    }
    .hero-media {
      max-width: 28rem;
      transform: none;
    }
    .pillars {
      grid-template-columns: 1fr;
    }
  }
</style>
