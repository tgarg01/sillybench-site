---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { url, mediaUrl, postUrl } from '../lib/url';
import { SITE } from '../site.config';
import { SERIES, upcoming, getSeries, releaseDay } from '../data/series';
import NextEpisode from '../components/NextEpisode.astro';

const all = await getCollection('posts', (p) => !p.data.draft);
const latest = [...all].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || b.data.episode - a.data.episode)[0];
const shelves = [...SERIES]
  .sort((a, b) => b.number - a.number)
  .map((s) => {
    const eps = all.filter((p) => p.data.series === s.id).sort((a, b) => b.data.episode - a.data.episode);
    return { s, eps, soon: upcoming(s, eps.map((p) => p.data.episode)) };
  })
  .filter((x) => x.eps.length);
const latestSeries = latest ? getSeries(latest.data.series) : undefined;
const nextUp = shelves.find((x) => x.s.id === latest?.data.series)?.soon;
---

<Base>
  <section class="wrap hero">
    <div class="intro">
      <p class="kicker">{SITE.name}</p>
      <h1 class="headline">Understand LLM inference by <span class="hl">visualizing</span> it on real hardware, with actual measured numbers and reproducible experiments.</h1>
      <div class="cta">
        {shelves[0] && <a class="btn" href={url(`/series/${shelves[0].s.id}/`)}>Start Series {shelves[0].s.number}</a>}
        {latest && <a class="btn ghost" href={postUrl(latest.id)}>Latest: Episode {latest.data.episode}</a>}
      </div>
      {
        latest && latestSeries && (
          <div class="now">
            <a class="now-item" href={postUrl(latest.id)}>
              <span class="kicker">Out now · Series {latestSeries.number}, Episode {latest.data.episode}</span>
              <span class="now-title hand">{latest.data.title}</span>
              <span class="now-desc">{latest.data.description}</span>
            </a>
            {nextUp && (
              <p class="now-next">
                <span class="kicker">Next · {releaseDay(nextUp.date)}</span>
                <span class="hand">Episode {nextUp.episode}: {nextUp.title}</span>
              </p>
            )}
          </div>
        )
      }
    </div>
    {
      latest && (
        <a class="hero-media card" href={postUrl(latest.id)} aria-label={`Watch episode ${latest.data.episode}: ${latest.data.title}`}>
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={mediaUrl(latest.data.media.dir, latest.data.media.loop.poster)}
            width={latest.data.media.loop.width}
            height={latest.data.media.loop.height}
            data-home-loop
          >
            <source src={mediaUrl(latest.data.media.dir, latest.data.media.loop.mp4)} type="video/mp4" />
          </video>
        </a>
      )
    }
  </section>

  <section class="wrap pillars" aria-label="How this works">
    <div class="pillar">
      <span class="n hand">1</span>
      <h2 class="h3">Measured</h2>
      <p>Real models on real inference engines and real GPUs, analyzed with Nsight Systems and Nsight Compute. No borrowed benchmarks.</p>
    </div>
    <div class="pillar">
      <span class="n hand">2</span>
      <h2 class="h3">Sourced</h2>
      <p>Each episode ends with where every number comes from: the run, the file, the formula, the datasheet.</p>
    </div>
    <div class="pillar">
      <span class="n hand">3</span>
      <h2 class="h3">Reproducible</h2>
      <p>Every episode links a Jupyter notebook that helps you understand the concept and reproduce it.</p>
    </div>
  </section>

  {
    shelves.map(({ s, eps, soon }) => (
      <section class="wrap series">
        <div class="series-head">
          <div>
            <p class="kicker">
              Series {s.number} · {eps.length} {eps.length === 1 ? 'episode' : 'episodes'}
            </p>
            <h2>{s.title}</h2>
          </div>
          <a href={url(`/series/${s.id}/`)}>All episodes →</a>
        </div>
        <div class="grid">
          {eps.map((p) => (
            <PostCard post={p} />
          ))}
          {soon && <NextEpisode next={soon} />}
        </div>
      </section>
    ))
  }

</Base>

<script>
  const v = document.querySelector<HTMLVideoElement>('[data-home-loop]');
  if (v && matchMedia('(prefers-reduced-motion: reduce)').matches) {
    v.removeAttribute('autoplay');
    v.pause();
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3rem;
    align-items: center;
    padding-top: 4rem;
    padding-bottom: 3rem;
  }
  .headline {
    font-size: clamp(1.9rem, 1.3rem + 2vw, 2.7rem);
    line-height: 1.18;
  }
  .hl {
    color: var(--green);
    background: linear-gradient(transparent 62%, var(--green-soft) 62%);
  }
  .cta {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .now {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--rule);
    display: grid;
    gap: 1rem;
    max-width: 34rem;
  }
  .now-item {
    display: grid;
    gap: 0.3rem;
    color: var(--ink);
    text-decoration: none;
  }
  .now-item:hover .now-title {
    color: var(--green);
  }
  .now-title {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .now-desc {
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .now-next {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    padding: 0.7rem 0.9rem;
    border: 1px dashed var(--rule);
    border-radius: 10px;
  }
  .now-next .hand {
    font-weight: 700;
    font-size: 1.1rem;
  }
  .hero-media {
    display: block;
    overflow: hidden;
    transform: rotate(1deg);
  }
  .hero-media video {
    width: 100%;
    aspect-ratio: 1;
    background: #f7f3ec;
  }
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }
  .pillar {
    border-top: 2px solid var(--ink);
    padding-top: 1rem;
  }
  .pillar .n {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--green);
  }
  .h3 {
    font-size: 1.4rem;
    margin: 0.1rem 0 0.4rem;
  }
  .pillar p {
    color: var(--ink-2);
    font-size: 0.98rem;
    margin: 0;
  }
  .series {
    padding-top: 3rem;
  }
  .series-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }
  .series-head .kicker {
    margin: 0 0 0.35rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1.25rem;
  }
  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-top: 2.5rem;
    }
    .now {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--rule);
    display: grid;
    gap: 1rem;
    max-width: 34rem;
  }
  .now-item {
    display: grid;
    gap: 0.3rem;
    color: var(--ink);
    text-decoration: none;
  }
  .now-item:hover .now-title {
    color: var(--green);
  }
  .now-title {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .now-desc {
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .now-next {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    padding: 0.7rem 0.9rem;
    border: 1px dashed var(--rule);
    border-radius: 10px;
  }
  .now-next .hand {
    font-weight: 700;
    font-size: 1.1rem;
  }
  .hero-media {
      max-width: 28rem;
      transform: none;
    }
    .pillars {
      grid-template-columns: 1fr;
    }
  }
</style>
