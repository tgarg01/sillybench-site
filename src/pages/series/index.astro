---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SERIES } from '../../data/series';
import { url, mediaUrl } from '../../lib/url';

const posts = await getCollection('posts', (p) => !p.data.draft);
const list = SERIES.map((s) => {
  const eps = posts.filter((p) => p.data.series === s.id).sort((a, b) => b.data.episode - a.data.episode);
  return { s, count: eps.length, latest: eps[0] };
}).sort((a, b) => b.s.number - a.s.number);
---

<Base title="Series" description="Every series on SillyBench.">
  <header class="wrap-narrow head">
    <h1>Series</h1>
    <p class="muted">Each series takes one setup from first principles down to the kernels, one episode at a time.</p>
  </header>
  <div class="wrap-narrow list">
    {
      list.map(({ s, count, latest }) => (
        <a class="series card" href={url(`/series/${s.id}/`)}>
          {latest && (
            <img src={mediaUrl(latest.data.media.dir, latest.data.media.card ?? latest.data.media.loop.poster)} alt="" width="200" height="200" loading="lazy" />
          )}
          <div>
            <p class="kicker">
              Series {s.number} · {count} {count === 1 ? 'episode' : 'episodes'}
            </p>
            <h2>{s.title}</h2>
            <p class="muted">{s.blurb}</p>
          </div>
        </a>
      ))
    }
  </div>
</Base>

<style>
  .head {
    padding-top: 3rem;
    padding-bottom: 1.5rem;
  }
  .head p {
    margin-top: 0.5rem;
  }
  .series {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1.25rem;
    align-items: center;
    padding: 1rem;
    color: var(--ink);
    text-decoration: none;
  }
  .series:hover {
    border-color: var(--green);
  }
  img {
    width: 9rem;
    height: 9rem;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid var(--rule);
  }
  h2 {
    font-size: 1.5rem;
    margin: 0.2rem 0 0.4rem;
  }
  .kicker,
  p {
    margin: 0;
  }
  @media (max-width: 520px) {
    .series {
      grid-template-columns: 1fr;
    }
    img {
      width: 100%;
      height: auto;
      aspect-ratio: 1;
    }
  }
</style>
