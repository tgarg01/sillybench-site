---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { SERIES, ARCS, PLAN, TOTAL_PARTS } from '../../data/series';
import { mediaUrl, postUrl, formatDate } from '../../lib/url';

const posts = await getCollection('posts', (p) => !p.data.draft && p.data.series === SERIES.id);
const byPart = new Map(posts.map((p) => [p.data.part, p]));
const arcName = Object.fromEntries(ARCS.map((a) => [a.id, a.name]));
---

<Base title={SERIES.title} description={SERIES.blurb}>
  <header class="wrap-narrow head">
    <p class="kicker">Season 1 · {posts.length} of {TOTAL_PARTS} parts out</p>
    <h1>{SERIES.title}</h1>
    <p class="lede">{SERIES.blurb}</p>
    <ul class="arcs" aria-label="Themes">
      {ARCS.map((a) => <li class="chip">{a.name}</li>)}
    </ul>
  </header>

  <ol class="wrap-narrow parts">
    {
      PLAN.map((pl) => {
        const p = byPart.get(pl.part);
        return p ? (
          <li class="part card live">
            <a href={postUrl(p.id)} class="thumb" tabindex="-1" aria-hidden="true">
              <img src={mediaUrl(p.data.media.dir, p.data.media.card ?? p.data.media.loop.poster)} alt="" width="160" height="160" loading="lazy" />
            </a>
            <div>
              <p class="kicker">
                Part {pl.part} · {arcName[pl.arc]} · {formatDate(p.data.date)}
              </p>
              <h2 class="t">
                <a href={postUrl(p.id)}>{p.data.title}</a>
              </h2>
              <p class="muted c">{pl.concept}</p>
            </div>
          </li>
        ) : (
          <li class="part planned">
            <span class="num mono" aria-hidden="true">{String(pl.part).padStart(2, '0')}</span>
            <div>
              <p class="kicker">
                Part {pl.part} · {arcName[pl.arc]} · coming soon
              </p>
              <h2 class="t">{pl.title}</h2>
              <p class="muted c">{pl.concept}</p>
            </div>
          </li>
        );
      })
    }
  </ol>

  <div class="wrap-narrow">
    <p class="muted note">The order of upcoming parts may change as the measurements lead somewhere new.</p>
    <NewsletterForm />
  </div>
</Base>

<style>
  .head {
    padding-top: 3rem;
    padding-bottom: 1.5rem;
  }
  .lede {
    font-size: 1.1rem;
    color: var(--ink-2);
    margin: 1rem 0;
  }
  .arcs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .parts {
    list-style: none;
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .part {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    align-items: center;
    padding: 0.85rem;
  }
  .live {
    position: relative;
  }
  .live .thumb img {
    width: 5.5rem;
    height: 5.5rem;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid var(--rule);
  }
  .live .t a {
    color: var(--ink);
    text-decoration: none;
  }
  .live .t a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .live:hover {
    border-color: var(--green);
  }
  .planned {
    border: 1px dashed var(--rule);
    border-radius: var(--radius);
  }
  .num {
    display: grid;
    place-items: center;
    width: 5.5rem;
    height: 3.5rem;
    font-size: 1.4rem;
    color: var(--muted);
  }
  .kicker {
    margin: 0 0 0.2rem;
  }
  .t {
    font-size: 1.25rem;
  }
  .planned .t {
    color: var(--ink-2);
  }
  .c {
    margin: 0.2rem 0 0;
    font-size: 0.93rem;
  }
  .note {
    font-size: 0.9rem;
    margin-top: 1.5rem;
  }
  @media (max-width: 480px) {
    .part {
      grid-template-columns: 4rem 1fr;
      gap: 0.75rem;
    }
    .live .thumb img {
      width: 4rem;
      height: 4rem;
    }
    .num {
      width: 4rem;
    }
  }
</style>
