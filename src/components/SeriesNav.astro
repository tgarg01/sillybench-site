---
import type { CollectionEntry } from 'astro:content';
import { postUrl, url } from '../lib/url';
import { getSeries } from '../data/series';

interface Props {
  current: CollectionEntry<'posts'>;
  all: CollectionEntry<'posts'>[];
}
const { current, all } = Astro.props;
const series = getSeries(current.data.series);
const episodes = all.filter((p) => p.data.series === current.data.series).sort((a, b) => a.data.episode - b.data.episode);
const i = episodes.findIndex((p) => p.id === current.id);
const prev = episodes[i - 1];
const next = episodes[i + 1];
---

<nav class="series-nav" aria-label="Series navigation">
  <p class="kicker">
    <a href={url(`/series/${series.id}/`)}>Series {series.number}: {series.title}</a>
  </p>
  {
    (prev || next) && (
      <div class="pn">
        {prev ? (
          <a class="card link" href={postUrl(prev.id)} rel="prev">
            <span class="muted small">← Episode {prev.data.episode}</span>
            <span class="t">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a class="card link right" href={postUrl(next.id)} rel="next">
            <span class="muted small">Episode {next.data.episode} →</span>
            <span class="t">{next.data.title}</span>
          </a>
        ) : (
          <span />
        )}
      </div>
    )
  }
</nav>

<style>
  .series-nav {
    margin: 3rem 0 2rem;
  }
  .kicker {
    margin-bottom: 0.75rem;
  }
  .kicker a {
    color: inherit;
  }
  .pn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.85rem 1rem;
    text-decoration: none;
    color: var(--ink);
  }
  a.link:hover {
    border-color: var(--green);
  }
  .right {
    text-align: right;
  }
  .t {
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 1.1rem;
    line-height: 1.2;
  }
  .small {
    font-size: 0.82rem;
  }
  @media (max-width: 560px) {
    .pn {
      grid-template-columns: 1fr;
    }
    .right {
      text-align: left;
    }
  }
</style>
