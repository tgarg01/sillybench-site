---
// The animation's caption steps as sharp stills, swipeable, plus the LinkedIn carousel PDF.
// Used inside a post's MDX as <StepGallery post={frontmatter} />.
import { mediaUrl } from '../lib/url';

interface Props {
  post: { title: string; media: { dir: string; stills?: { src: string; full: string }[]; carousel?: string } };
}
const { post } = Astro.props;
const { dir, stills = [], carousel } = post.media;
const m = (f: string) => mediaUrl(dir, f);
---

{
  stills.length > 0 && (
    <section class="gallery" aria-label="Step by step" data-gallery>
      <div class="head">
        <h2>Step by step</h2>
        <div class="controls">
          <span class="mono count" aria-live="polite" data-count>
            1 / {stills.length}
          </span>
          <button type="button" data-prev aria-label="Previous step">←</button>
          <button type="button" data-next aria-label="Next step">→</button>
        </div>
      </div>
      <ol class="strip" data-strip tabindex="0" aria-label="Steps; scroll sideways">
        {stills.map((s, i) => (
          <li>
            <a href={m(s.full)} target="_blank" rel="noopener" aria-label={`Step ${i + 1} of ${stills.length}, full size`}>
              <img
                src={m(s.src)}
                srcset={`${m(s.src)} 1080w, ${m(s.full)} 2160w`}
                sizes="(max-width: 720px) 86vw, 34rem"
                width="1080"
                height="1080"
                loading="lazy"
                decoding="async"
                alt={`${post.title}: step ${i + 1} of ${stills.length}`}
              />
            </a>
          </li>
        ))}
      </ol>
      {carousel && (
        <p class="dl">
          <a class="btn ghost" href={m(carousel)} download>
            Download all steps as PDF
          </a>
          <span class="muted">Same slides as the LinkedIn carousel.</span>
        </p>
      )}
    </section>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const strip = g.querySelector<HTMLElement>('[data-strip]')!;
    const items = [...strip.children] as HTMLElement[];
    const count = g.querySelector<HTMLElement>('[data-count]')!;
    const current = () => {
      const x = strip.scrollLeft;
      let best = 0;
      items.forEach((it, i) => {
        if (Math.abs(it.offsetLeft - strip.offsetLeft - x) < Math.abs(items[best].offsetLeft - strip.offsetLeft - x)) best = i;
      });
      return best;
    };
    const go = (i: number) => {
      const t = items[Math.max(0, Math.min(items.length - 1, i))];
      strip.scrollTo({ left: t.offsetLeft - strip.offsetLeft, behavior: 'smooth' });
    };
    g.querySelector('[data-prev]')!.addEventListener('click', () => go(current() - 1));
    g.querySelector('[data-next]')!.addEventListener('click', () => go(current() + 1));
    strip.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(current() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(current() - 1); }
    });
    let raf = 0;
    strip.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => (count.textContent = `${current() + 1} / ${items.length}`));
    });
  });
</script>

<style>
  .gallery {
    margin: 3rem 0;
  }
  .head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .count {
    font-size: 0.85rem;
    color: var(--muted);
    margin-right: 0.35rem;
  }
  .controls button {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid var(--rule);
    background: var(--paper-2);
    color: var(--ink);
    font-size: 1.1rem;
    cursor: pointer;
  }
  .controls button:hover {
    background: var(--code-bg);
  }
  .strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(86%, 34rem);
    gap: 0.9rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    list-style: none;
    margin: 0;
    padding: 0 0 0.75rem;
    overscroll-behavior-x: contain;
  }
  .strip li {
    scroll-snap-align: start;
  }
  .strip img {
    width: 100%;
    border-radius: 12px;
    border: 1px solid var(--rule);
    background: #f7f3ec;
  }
  .dl {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 0.75rem;
    font-size: 0.92rem;
  }
</style>
