---
import type { CollectionEntry } from 'astro:content';
import { mediaUrl, postUrl, formatDate } from '../lib/url';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const d = post.data;
---

<article class="pc card">
  <a href={postUrl(post.id)} class="thumb" tabindex="-1" aria-hidden="true">
    <img src={mediaUrl(d.media.dir, d.media.card ?? d.media.loop.poster)} alt="" width="540" height="540" loading="lazy" decoding="async" />
  </a>
  <div class="body">
    <p class="kicker">Part {d.part} · {formatDate(d.date)}</p>
    <h3><a href={postUrl(post.id)}>{d.title}</a></h3>
  </div>
</article>

<style>
  .pc {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease;
  }
  .pc:hover {
    transform: translateY(-2px);
  }
  .thumb img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-bottom: 1px solid var(--rule);
    background: #f7f3ec;
  }
  .body {
    padding: 0.9rem 1rem 1.1rem;
  }
  .kicker {
    margin: 0 0 0.35rem;
  }
  h3 {
    font-size: 1.2rem;
  }
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .pc {
    position: relative;
  }
  h3 a:hover {
    color: var(--green);
  }
</style>
