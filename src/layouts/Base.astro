---
import '@fontsource/kalam/400.css';
import '@fontsource/kalam/700.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { SITE } from '../site.config';
import { url } from '../lib/url';
import { SERIES } from '../data/series';

interface Props {
  title?: string;
  description?: string;
  image?: string; // absolute or site-relative URL of the OG image
  type?: 'website' | 'article';
  published?: Date;
}

const { title, description = SITE.description, image, type = 'website', published } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? url('/og-default.png'), Astro.site);
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const nav = [
  { href: '/series/', label: 'Series', match: ['/series', '/posts'] }, // episode pages live under /posts/
  { href: '/about/', label: 'About', match: ['/about'] },
];
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content="#f7f3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161513" media="(prefers-color-scheme: dark)" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="author" content={SITE.author} />

    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <slot name="head" />
    {
      SITE.goatcounter && (
        <script
          is:inline
          async
          data-goatcounter={`https://${SITE.goatcounter}.goatcounter.com/count`}
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <a class="skip sr-only" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={url('/')} aria-label={`${SITE.name} home`}>
          <svg class="logo" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="5" y="5" width="22" height="22" rx="4" fill="none" stroke="currentColor" stroke-width="2.2"></rect>
            <rect x="11" y="11" width="10" height="10" rx="1.5" fill="var(--green)"></rect>
            <path d="M10 2v3M16 2v3M22 2v3M10 27v3M16 27v3M22 27v3M2 10h3M2 16h3M2 22h3M27 10h3M27 16h3M27 22h3" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <span>{SITE.name}</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={url(n.href)} aria-current={n.match.some((m) => path.startsWith(m)) ? 'page' : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="tools">
          <a class="icon-btn" href={url('/search/')} aria-label="Search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
          </a>
          <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle dark mode">
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div>
          <p class="hand foot-name">{SITE.name}</p>
          <p class="muted">Measured on real hardware. Sourced. Reproducible.</p>
        </div>
        <ul class="foot-links">
          <li><a href={url('/rss.xml')}>RSS</a></li>
          {SITE.links.linkedin && <li><a href={SITE.links.linkedin}>LinkedIn</a></li>}
          {SERIES.map((s) => <li><a href={s.repo}>{s.repo.split('/').pop()}</a></li>)}
        </ul>
        <p class="muted small">© {new Date().getFullYear()} {SITE.author}</p>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', () => {
          const root = document.documentElement;
          const current =
            root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          const next = current === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
        });
      })();
    </script>
  </body>
</html>

<style>
  .skip:focus {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    width: auto;
    height: auto;
    clip: auto;
    padding: 0.5rem 0.75rem;
    background: var(--ink);
    color: var(--paper);
    z-index: 100;
    border-radius: 8px;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 60px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 1.3rem;
    white-space: nowrap;
  }
  .logo {
    width: 28px;
    height: 28px;
  }
  nav {
    margin-left: auto;
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 0.4rem 0.6rem;
    border-radius: 8px;
    color: var(--ink-2);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
    background: var(--code-bg);
  }
  .tools {
    display: flex;
    gap: 0.25rem;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .icon-btn:hover {
    background: var(--code-bg);
  }
  .icon-btn svg {
    width: 20px;
    height: 20px;
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .moon {
      display: block;
    }
  }
  @media (max-width: 720px) {
    .bar {
      flex-wrap: wrap;
      gap: 0 0.5rem;
      padding-top: 0.4rem;
    }
    nav {
      order: 3;
      width: 100%;
      margin: 0 calc(-1 * var(--gutter));
      padding: 0 var(--gutter) 0.4rem;
      width: calc(100% + 2 * var(--gutter));
    }
    .tools {
      margin-left: auto;
    }
  }
  main {
    min-height: 70vh;
  }
  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--rule);
    background: var(--paper);
    padding: 2.5rem 0 3rem;
  }
  .foot {
    display: grid;
    gap: 1rem;
  }
  .foot-name {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0;
  }
  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .small {
    font-size: 0.85rem;
    margin: 0;
  }
</style>
